# ─── Deployment mode ──────────────────────────────────────────────────────────
# Options: standalone | saas | hybrid
DEPLOYMENT_MODE=standalone

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://vairiot:change-me-postgres-password@localhost:5432/vairiot_dev"
POSTGRES_USER=vairiot
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=vairiot_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d
# Encrypts secrets stored in the database (SMTP passwords, 2FA secrets).
# At least 32 chars: openssl rand -base64 48. Never change it once data exists.
# Required in production (the API and worker refuse to start without it).
APP_ENCRYPTION_KEY=change-me-app-encryption-key

# Password given to the demo accounts by `npm run db:seed` (never printed, KFR-037).
# Mixed case and digits to satisfy the password policy.
SEED_DEMO_PASSWORD=change-me-seed-demo-password

# ─── Web app ──────────────────────────────────────────────────────────────────
WEB_PORT=3000
VITE_API_URL=http://81.85.92.155

# ─── File storage (MinIO — S3-compatible) ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=vairiot-minio
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_BUCKET=vairiot-documents
MINIO_PHOTOS_BUCKET=vairiot-photos
MINIO_DOCUMENTS_BUCKET=vairiot-documents
# Bucket-limited user the API connects as (created by minio-init in production).
# Leave unset locally to use the root credentials above.
# MINIO_ACCESS_KEY=vairiot-app
# MINIO_SECRET_KEY=changeme-minio-app

# ─── Email (for notifications — optional in standalone) ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=change-me-smtp-password
EMAIL_FROM="Vairiot <notifications@example.com>"

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Options: error | warn | info | debug

# ─── SaaS / Hybrid only ───────────────────────────────────────────────────────
# Leave blank for standalone deployments
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=
