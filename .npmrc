# Make package downloads survive a transient connection reset.
#
# Production Docker builds on the Vairiot host failed three times on 3 Sep 2026,
# each at `npm install`, each succeeding on retry with nothing changed. Captured
# under a reproduction build, the failure is:
#
#   npm error code ECONNRESET
#   npm error network aborted
#
# One reset ~84s into fetching kills the whole step and takes the image build
# with it. npm's defaults give up after 2 retries with a short backoff, which is
# not enough when a build pulls ~1240 packages and several services build in
# parallel.
fetch-retries=5
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
