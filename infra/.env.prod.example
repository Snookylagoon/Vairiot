# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=vairiot
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=vairiot

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password

# ─── MinIO (S3-compatible file storage) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password
# Bucket-limited user the API connects as instead of root; minio-init creates
# it on each deploy. Must differ from MINIO_ROOT_USER; secret at least 16 chars.
MINIO_ACCESS_KEY=vairiot-app
MINIO_SECRET_KEY=CHANGE_ME_strong_password

# ─── API ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_64_char_string
# Required: encrypts secrets stored in the database (SMTP passwords, 2FA).
# openssl rand -base64 48 — NEVER change it once set, or that data is lost.
APP_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_48
WEB_ORIGIN=https://your-domain.com

# ─── Web (build-time) ──────────────────────────────────────────────────────
VITE_API_URL=https://your-domain.com

# ─── Backups (encrypted, off-site — see DEPLOY.md) ──────────────────────────
BACKUP_AGE_RECIPIENT=age1CHANGE_ME_public_key
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=vairiot-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME

# ─── Alerts (optional) ──────────────────────────────────────────────────────
# SENTRY_DSN=
# OPS_ALERT_EMAIL=
