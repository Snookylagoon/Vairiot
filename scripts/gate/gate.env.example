# The gate stack's settings: copy to $GATE_DIR/gate.env and fill the secrets
# (openssl rand -hex 32 for each). Throwaway values, never a server's.
POSTGIS_IMAGE=imresamu/postgis:16-3.5-alpine
POSTGRES_USER=vairiot
POSTGRES_PASSWORD=
POSTGRES_DB=vairiot
REDIS_PASSWORD=
MINIO_ROOT_USER=gate-minio
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=gate-app
MINIO_SECRET_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
APP_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
WEB_ORIGIN=https://assets.gate.localhost:18443
VITE_API_URL=https://assets.gate.localhost:18443
APP_SERVER_NAME=assets.gate.localhost
ADMIN_SERVER_NAME=admin.gate.localhost
TLS_CERT=/etc/vairiot/tls/cert.pem
TLS_KEY=/etc/vairiot/tls/key.pem
