{
  "name": "vairiot",
  "version": "1.0.0",
  "private": true,
  "description": "Vairiot Enhanced Asset Management Platform \u2014 monorepo root",
  "workspaces": [
    "vairiot-api",
    "vairiot-web",
    "vairiot-admin",
    "vairiot-worker",
    "vairiot-shared"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "dev": "docker compose -f infra/docker-compose.yml up",
    "dev:api": "npm run dev --workspace=vairiot-api",
    "dev:web": "npm run dev --workspace=vairiot-web",
    "dev:admin": "npm run dev --workspace=vairiot-admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "./scripts/test-api.sh",
    "db:migrate": "npm run db:migrate --workspace=vairiot-api",
    "db:studio": "npm run db:studio --workspace=vairiot-api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
